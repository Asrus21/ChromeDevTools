{
  "name": "chrome-devtools-mcp-worker",
  "version": "1.0.0",
  "description": "Servidor MCP remoto na Cloudflare que controla um Chrome headless (Browser Rendering) como ferramentas MCP.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run dry-run",
    "dry-run": "wrangler deploy --dry-run",
    "test": "node --experimental-transform-types --test \"tests/*.test.ts\"",
    "cf-typegen": "wrangler types"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.4",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.21.0",
    "zod": "^4.4.3"
  }
}
